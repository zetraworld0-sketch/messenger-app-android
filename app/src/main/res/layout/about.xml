<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical" >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1"
        android:background="@color/myPrimaryColor" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Your Brand Name replaces the giant 'mesibo' text -->
            <TextView
                android:id="@+id/mesibologo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:gravity="center_horizontal"
                android:text="NETSCAPE"
                android:layout_marginTop="40dp"
                android:padding="5dp"
                android:textSize="50sp" 
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="SOVEREIGN HUB"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:alpha="0.8"
                android:layout_marginBottom="30dp"/>

            <!-- Version Info -->
            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Build v1.0.0-Stable"
                android:padding="5dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textAppearance="@android:style/TextAppearance.Medium" />

            <TextView
                android:id="@+id/builddate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="May 2026 Release"
                android:padding="5dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textAppearance="@android:style/TextAppearance.Small" />

            <!-- App Philosophy -->
            <TextView
                android:id="@+id/appDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="A high-fidelity, institutional-grade communication engine developed by Zetra Lab."
                android:padding="20dp"
                android:textColor="@color/white"
                android:visibility="visible"
                android:textAppearance="@android:style/TextAppearance.Medium" />

            <!-- Website Link - Updated to your domain or placeholder -->
            <TextView
                android:id="@+id/website"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:autoLink="web"
                android:text="https://zetralab.com"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColorLink="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"
                android:text="© 2026 Zetra Lab. All rights reserved."
                android:textColor="@color/white"
                android:alpha="0.6"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
