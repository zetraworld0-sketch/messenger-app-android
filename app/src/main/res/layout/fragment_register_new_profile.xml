<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/register_new_profile_rootlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ebebeb"
    android:fitsSystemWindows="true">

    <!-- 1. SCROLLABLE CONTENT AREA -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/register_profile_save"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Profile Image Header -->
            <RelativeLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_margin="30dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/self_user_image"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/default_user_image"
                    app:shapeAppearanceOverlay="@style/CircleImageStyle"
                    app:strokeColor="@color/white"
                    app:strokeWidth="2dp" />

                <ImageView
                    android:id="@+id/edit_user_image"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/ic_lens_green_900_48dp"
                    android:elevation="4dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_photo_camera_black_18dp"
                    app:tint="@color/white" />
            </RelativeLayout>

            <!-- Name Input Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/name_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginHorizontal="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <com.mesibo.emojiview.EmojiconEditText
                        android:id="@+id/name_emoji_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/editor_background"
                        android:hint="Enter your name"
                        android:inputType="textPersonName"
                        android:paddingStart="40dp"
                        android:paddingEnd="40dp"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/name_char_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignStart="@id/name_emoji_edittext"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:text="25"
                        android:textColor="#FF9800"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/name_emoji_btn"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignEnd="@id/name_emoji_edittext"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_sentiment_satisfied_black_24dp"
                        app:tint="#4CAF50" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:text="This name will be visible to your contacts and groups"
                android:textColor="#777"
                android:textSize="12sp" />

            <!-- Status and Phone Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STATUS"
                        android:textColor="#1B5E20"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <com.mesibo.emojiview.EmojiconEditText
                            android:id="@+id/status_emoji_edittext"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/editor_background"
                            android:hint="Type your profile status here"
                            android:minHeight="48dp"
                            android:paddingStart="40dp"
                            android:paddingEnd="40dp"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/status_char_counter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignStart="@id/status_emoji_edittext"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="10dp"
                            android:text="150"
                            android:textColor="#FF9800"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/status_emoji_btn"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignEnd="@id/status_emoji_edittext"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_sentiment_satisfied_black_24dp"
                            app:tint="#4CAF50" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="#EEEEEE" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHONE"
                        android:textColor="#1B5E20"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/profile_self_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="+18885551234"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 2. STICKY ACTION BUTTON -->
    <FrameLayout
        android:id="@+id/register_profile_save"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:text="Next"
            android:textAllCaps="false"
            android:textSize="18sp"
            app:backgroundTint="@color/myPrimaryColor"
            app:cornerRadius="4dp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
